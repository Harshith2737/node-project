{
  "name": "telangana-heritage-platform",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check.js",
    "db:check": "node --env-file-if-exists=.env.local scripts/check-db.js",
